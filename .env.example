# Notion — internal integration token with access to the 7 content/support DBs + Pipeline Events
NOTION_TOKEN=secret_xxx
# Pin the Notion API version (data-sources era)
NOTION_VERSION=2025-09-03

# Typefully — OPTIONAL. Leave the key empty and every platform uses the manual
# copy-paste lane (Approve → COPY → Mark Posted). Set a key to enable
# zero-touch publishing, scoped to TYPEFULLY_PLATFORMS; force manual anytime
# with PUBLISH_MODE=manual.
TYPEFULLY_API_KEY=
# Optional: pin a social set. If empty, the first social set on the account is used.
TYPEFULLY_SOCIAL_SET_ID=
# Optional: comma-separated platform keys to auto-publish once the key is set.
# Default "x" — everything else stays manual until added, e.g. "x,substack".
TYPEFULLY_PLATFORMS=
# PUBLISH_MODE=manual

# Notion data source IDs (run `npm run discover` to verify, `npm run migrate` to prepare schemas)
DS_X=a5d8469f-8807-4e66-b8b7-31dbf414d103
DS_LINKEDIN=daa5bffd-96b9-4864-aca0-61a8a1bfdf11
DS_IG_STORY=58dd1e1a-a868-4b86-8690-14945ec72cba
DS_IG_CAROUSEL=5fdd5231-f28d-4cb9-b1a2-b3389d6e972b
DS_SUBSTACK_NOTES=83e1fe3e-136b-41d3-8c61-333ab0882b0b
DS_POSITIONS=fd5f9efb-721d-40b5-b932-bf198e88f953
DS_INBOX=02d3dbb3-50d6-47d3-951d-5b05d46a8699
DS_WIKI=2316d4b5-2d25-44d4-87e5-13539945fd8b
# Created by `npm run migrate` (Pipeline Events DB) — paste the printed data source id here
DS_EVENTS=
# Created by `npm run migrate` (Calibration Events DB) — paste the printed id here
DS_CALIBRATION_EVENTS=
# Created by `npm run migrate` (Position Proposals DB) — paste the printed id here
DS_PROPOSALS=
# Weekly Positions Survey page (defaults to the Constitution's survey page)
# NOTION_SURVEY_PAGE=36f1fec9ef8381ceb927eca8fa3c5ed6

# Auth: SHA-256 hex of the login passphrase. Generate with:
#   node -e "console.log(require('crypto').createHash('sha256').update('your-passphrase').digest('hex'))"
AUTH_SECRET=
# Random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Vercel cron authentication (set the same value in Vercel project env; Vercel sends it as Authorization: Bearer)
CRON_SECRET=

# Machine lane for Hermes (export + draft bridge). Sent as `Authorization: Bearer <token>`.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable the machine lane entirely (GET /api/hermes/export returns 401).
HERMES_API_TOKEN=

TZ=Asia/Singapore
