# Env for hermes/scripts/sync_command_center_calibration.py
# Copy to .env on the Mac mini (or export these in the shell/cron environment).
# Never commit a real .env -- this repo's .gitignore already excludes .env.

# Base URL of the Command Center deployment. Defaults to the production
# Vercel URL below if unset, so this line only needs to change for local
# testing against `npm run dev`.
COMMAND_CENTER_URL=https://isaac-twin-command-center.vercel.app

# Bearer token for the machine lane (docs/hermes-integration.md). Required
# for every real (non-dry-run) invocation. Not needed for --fixture (test-
# only, never touches the network). Generated at the Command Center
# final gate and set on Vercel -- ask the orchestrator / Isaac for the value,
# never invent one. Without this set, the script exits 2 with a one-line
# error (or, in --dry-run, prints a "NO TOKEN" structure-only stub instead).
HERMES_API_TOKEN=

# Optional. Overrides where the script resolves the twin repo root (where it
# reads/writes inbox/calibration/). Leave unset on the Mac mini -- the script
# defaults to two directories up from its own location, which is correct
# once this script lives at <twin repo>/scripts/sync_command_center_
# calibration.py. Only set this for local testing (e.g. a scratch directory).
TWIN_ROOT=
