# Env for hermes/scripts/sync_command_center_calibration.py
# Copy to .env on the Mac mini (or export these in the shell/cron environment).
# Never commit a real .env -- this repo's .gitignore already excludes .env.

# Base URL of the Command Center deployment. Defaults to the production
# Vercel URL below if unset, so this line only needs to change for local
# testing against `npm run dev`.
COMMAND_CENTER_URL=https://isaac-twin-command-center.vercel.app

# Bearer token for the machine lane (docs/hermes-integration.md). Required
# for every real (non-dry-run) invocation. Not needed for --fixture (test-
# only, never touches the network). Generated at the Command Center
# final gate and set on Vercel -- ask the orchestrator / Isaac for the value,
# never invent one. Without this set, the script exits 2 with a one-line
# error (or, in --dry-run, prints a "NO TOKEN" structure-only stub instead).
HERMES_API_TOKEN=

# Optional. Overrides where the script resolves the twin repo root (where it
# reads/writes inbox/calibration/). Leave unset on the Mac mini -- the script
# defaults to two directories up from its own location, which is correct
# once this script lives at <twin repo>/scripts/sync_command_center_
# calibration.py. Only set this for local testing (e.g. a scratch directory).
TWIN_ROOT=

# --- hermes/scripts/telegram_approval_bridge.py (Phase 9) -----------------
# Env for the Telegram approval bridge worker. Reuses COMMAND_CENTER_URL,
# HERMES_API_TOKEN, and TWIN_ROOT above (the bridge's state file lives at
# $TWIN_ROOT/.telegram-bridge-state.json). See docs/telegram-approval-
# bridge.md and hermes/runbooks/telegram-approval-bridge.md.

# Telegram Bot API token for the bridge's own bot. Required for every real
# (non-dry-run, non-fixture) invocation. Never printed or logged by the
# worker, in any mode. Generated via @BotFather -- ask Isaac, never invent
# one. Confirm first whether Hermes's actual Telegram gateway is the
# standard Bot API or a thinner relay (open question O1 in the design doc)
# before wiring this up for real.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram chat/user ids authorised to approve/
# reject/edit drafts (and the destination(s) drafts are sent to). Every
# inbound reply is checked against this list before any decision is applied
# -- this is the primary authZ boundary on the reply side (design §7). An
# empty value disables the whole bridge for a real run (fails closed, exit
# 2). Confirm Isaac's exact numeric id (open question O2 in the design doc)
# -- do not guess or invent one.
TELEGRAM_CHAT_ID_ALLOWLIST=

# Optional. The launchd StartInterval (seconds) this worker is meant to run
# under -- documentation/consistency only; also loosely caps the in-request
# Telegram getUpdates long-poll wait so one invocation returns quickly.
# Default: 300 (5 minutes, per docs/telegram-approval-bridge.md §3).
TELEGRAM_BRIDGE_POLL_SECONDS=

# Optional. Max characters of a draft body included in the outbound
# Telegram message. Default: 600 (docs/telegram-approval-bridge.md §4).
BODY_EXCERPT_CHARS=
